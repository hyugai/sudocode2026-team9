          "role_label": "Khách",
          "voice_id": "NU_1",
          "voice_label": "Nữ 1",
          "customer_turn_index": 1,
          "text": "có, nhà chị có bé hai tuổi, ngân sách tầm năm triệu thôi em",
          "source_body_index": 17
        },
        {
          "turn_index": 4,
          "turn_number": 5,
          "role": "advisor",
          "role_label": "Tư vấn",
          "voice_id": "NU_2",
          "voice_label": "Nữ 2",
          "customer_turn_index": null,
          "text": "dạ vậy em gợi ý mẫu e pia y có khóa trẻ em, giá năm triệu hai trăm nghìn, đang có khuyến mãi tặng một màng lọc đến hết ngày hai mươi hai tháng mười ạ",
          "source_body_index": 18
