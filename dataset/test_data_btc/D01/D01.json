        {
          "turn_index": 7,
          "turn_number": 8,
          "role": "customer",
          "role_label": "Khách",
          "voice_id": "NU_1",
          "voice_label": "Nữ 1",
          "customer_turn_index": 3,
          "text": "ừ để chị hỏi ông xã rồi gọi lại em nhé",
