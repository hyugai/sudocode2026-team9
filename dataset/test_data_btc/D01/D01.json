        {
          "turn_index": 5,
          "turn_number": 6,
          "role": "customer",
          "role_label": "Khách",
          "voice_id": "NU_1",
          "voice_label": "Nữ 1",
          "customer_turn_index": 2,
          "text": "hơi vượt ngân sách chị chút, còn mẫu x thì bao nhiêu",
          "source_body_index": 19
        },
        {
          "turn_index": 6,
          "turn_number": 7,
          "role": "advisor",
          "role_label": "Tư vấn",
          "voice_id": "NU_2",
          "voice_label": "Nữ 2",
          "customer_turn_index": null,
          "text": "dạ mẫu x là bốn triệu tám trăm chín mươi nghìn, cũng được tặng màng lọc, nhưng không có khóa trẻ em chị ạ",
          "source_body_index": 20
