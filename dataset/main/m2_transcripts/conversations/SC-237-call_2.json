  "utterances": [
    {
      "speaker": "customer",
      "text": "Tôi là Hương, số điện thoại 0979298416, đã nhắn qua Fanpage. Chị cần xử lý nốt việc lần trước. Em nhắc đúng hai món cuối cùng sau khi sửa và tổng tiền nhé.",
      "source_customer_turn_index": 0
    },
    {
      "speaker": "agent",
      "text": "Dạ chị, giỏ đã sửa gồm Nồi chiên không dầu Lock&Lock 4L và Máy tiệt trùng sấy khô Moaz Bebe; món đã bỏ không còn trong giỏ. Tổng hàng hôm nay là 3.780.000 đồng.",
      "source_refs": [
        "schemas/tools.schema.json",
