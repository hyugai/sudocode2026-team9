      "tool_refs": [
        0,
        1,
        2,
        3
      ]
    },
    {
      "speaker": "customer",
      "text": "Em nhắc lại từng máy được hưởng chương trình nào và tổng hôm nay; đừng cộng hai ưu đãi độc quyền trên cùng một máy.",
      "source_customer_turn_index": 1
    },
    {
      "speaker": "agent",
      "text": "AIR-2ND-50 chỉ giảm cho một máy lọc không khí có giá niêm yết thấp nhất trong đơn; nếu cùng giá thì chọn máy đứng sau. Dù mua ba máy, toàn đơn vẫn chỉ có một máy nhận giảm 50%, không phải mỗi cặp được giảm một lần. Mỗi máy chỉ nhận một ưu đãi không cộng dồn; các máy còn lại có thể nhận ưu đãi phù hợp riêng. Máy 1, Máy lọc không khí Samsung AX40: 6.490.000 đồng, không có giảm giá riêng; Máy 2, Máy lọc không khí AirPure X: 2.445.000 đồng, AIR-2ND-50. Tổng hàng 8.935.000 đồng.",
      "source_refs": [
        "schemas/tools.schema.json",
