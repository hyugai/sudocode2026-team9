        "verdict": {"type": "string", "enum": ["pass", "fail", "uncertain"]},
        "reason": {"type": "string"},
        "evidence": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["transcript_id", "turn_index", "quote"],
          "properties": {"transcript_id": {"type": "string"}, "turn_index": {"type": "integer"}, "quote": {"type": "string"}}
        }}
      }
    }}
  }
}
