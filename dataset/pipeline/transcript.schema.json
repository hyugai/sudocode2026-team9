{
  "type": "object",
  "additionalProperties": false,
  "required": ["transcript_id", "customer_id", "session_index", "channel", "outcome", "utterances",
    "journey_id", "language", "date", "persona", "hard_case", "previous_transcript_id",
    "origin", "is_actual_agent_trace", "review_status", "provenance"],
  "properties": {
    "transcript_id": {"type": "string"},
    "customer_id": {"type": "string"},
    "session_index": {"type": "integer"},
    "channel": {"type": "string", "enum": ["hotline", "chat_fanpage", "zalo_oa"]},
    "outcome": {"type": "string"},
    "journey_id": {"type": "string"},
    "language": {"type": "string", "enum": ["vi"]},
    "date": {"type": "string", "format": "date"},
    "persona": {"type": "string"},
    "hard_case": {"type": ["string", "null"]},
    "previous_transcript_id": {"type": ["string", "null"]},
    "origin": {"type": "string", "enum": ["synthetic_llm_reference"]},
    "is_actual_agent_trace": {"type": "boolean", "enum": [false]},
    "review_status": {"type": "string", "enum": ["automated_approved"]},
    "provenance": {"type": "object", "additionalProperties": false,
      "required": ["plan_sha256", "request_sha256", "automated_review_sha256"], "properties": {
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "automated_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }},
    "utterances": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["speaker", "text"],
      "properties": {"speaker": {"type": "string", "enum": ["customer", "agent"]}, "text": {"type": "string"}}
    }}
  }
}
