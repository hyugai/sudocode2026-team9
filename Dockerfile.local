FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Use CPU wheels for local embeddings instead of downloading CUDA libraries.
RUN python -m pip install --upgrade pip \
    && python -m pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY pyproject.toml ./
# Installing editable keeps the repository paths used by MCP and memory intact.
RUN mkdir -p src && python -m pip install -e ".[voice,realtime,learning]"

COPY src ./src
COPY scripts ./scripts
COPY dataset/organizer ./dataset/organizer
# Only static agent instructions belong in the image. Customer memory is seeded
# by init from organizer/catalog/crm_seed.json into a dedicated Docker volume.
COPY data/memory-root/agents/telesales_agent/agent.md \
     data/memory-root/agents/telesales_agent/soul.md \
     data/memory-root/agents/telesales_agent/tools.md ./data/memory-root/agents/telesales_agent/

EXPOSE 10000

HEALTHCHECK --interval=10s --timeout=10s --start-period=180s --retries=12 \
    CMD curl --fail http://127.0.0.1:${PORT:-10000}/health || exit 1

CMD ["sh", "-c", "exec python -m uvicorn telesale_agent.entrypoints.api.chat:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]
