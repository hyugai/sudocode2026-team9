      {
        "message_id": 0,
        "role": "customer",
        "content": "Alo em, chị muốn xem Giày sneaker Urban Classic, size 40, màu đen, giá hiện tại có phải 890.000 đồng không?"
      },
      {
        "message_id": 1,
        "role": "agent",
        "content": "Dạ em chào chị [private], sản phẩm Giày sneaker Urban Classic, size 40, màu đen hiện đúng là đang có giá 890.000 đồng ạ. Mẫu này bên em vẫn còn hàng, chị có muốn em hỗ trợ đặt đơn cho mình luôn không chị?"
      },
      {
        "message_id": 2,
        "role": "customer",
        "content": "Chị chỉ tham khảo, chưa đặt đơn. Khi quay lại chị sẽ hỏi thêm điều kiện đổi size."
      },
      {
        "message_id": 3,
        "role": "agent",
        "content": "Dạ em hiểu rồi ạ. Chị [private] cứ tham khảo thêm, khi nào quay lại muốn tìm hiểu về điều kiện đổi size hay cần hỗ trợ gì khác, chị cứ báo em nhé. \n\nEm chúc chị một ngày vui vẻ ạ!"
      },
      {
        "message_id": 4,
        "role": "customer",
        "content": "Em ghi nhớ giúp sản phẩm này để lần sau mình không phải nói lại nhé."
      },
      {
        "message_id": 5,
        "role": "agent",
        "content": "Dạ em hiểu rồi ạ, chị [private] cứ yên tâm nhé. Khi nào quay lại cần tư vấn thêm hay cần hỗ trợ gì khác, chị cứ báo em nha. Em chúc chị một ngày tốt lành ạ!"
      }
