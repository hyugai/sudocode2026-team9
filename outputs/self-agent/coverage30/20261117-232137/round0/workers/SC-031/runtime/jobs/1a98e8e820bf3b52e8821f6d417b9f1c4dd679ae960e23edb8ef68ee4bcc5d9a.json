    "messages": [
      {
        "message_id": 0,
        "role": "customer",
        "content": "Alo em, chị muốn xem Giày sneaker Urban Classic, size 40, màu đen, giá hiện tại có phải 890.000 đồng không?"
      },
      {
        "message_id": 1,
        "role": "agent",
        "content": "Dạ em chào chị [private], mẫu Giày sneaker Urban Classic size 40 màu đen hiện đang có giá chính xác là 890.000 đồng và bên em vẫn còn hàng chị nha. \n\nChị có muốn em hỗ trợ lên đơn đặt hàng sản phẩm này cho mình luôn không ạ?"
      },
      {
        "message_id": 2,
        "role": "customer",
        "content": "Chị chỉ tham khảo, chưa đặt đơn. Khi quay lại chị sẽ hỏi thêm điều kiện đổi size."
      },
      {
        "message_id": 3,
        "role": "agent",
        "content": "Dạ vâng em ghi nhận lại thông tin rồi ạ. Khi nào cần tham khảo chi tiết về điều kiện đổi size, chị cứ liên hệ lại để em hỗ trợ chị [private] chu đáo nhé. Em chúc chị một ngày tốt lành ạ!"
      },
      {
        "message_id": 4,
        "role": "customer",
        "content": "Em ghi nhớ giúp sản phẩm này để lần sau mình không phải nói lại nhé."
      },
      {
        "message_id": 5,
        "role": "agent",
        "content": "Dạ em đã ghi nhớ thông tin sản phẩm và nhu cầu tìm hiểu điều kiện đổi size của chị [private] rồi ạ. Lần sau chị gọi lại, em sẽ hỗ trợ chị ngay mà chị không cần phải lặp lại thông tin nữa đâu ạ. Em chúc chị một ngày vui vẻ!"
      }
    ],
