      "mechanism": "knowledge_gap",
      "content": {
        "title": "Verify Cart Item Pricing Before Asserting Totals",
        "when": "A customer updates cart items or states a total budget and requests cart verification, but product prices or total amounts have not been retrieved or verified via tools.",
        "do": "Retrieve product pricing using system tools and verify cart item costs before stating or confirming total amounts.",
        "otherwise": "Express uncertainty about the total cart cost without stating unconfirmed prices or totals."
      },
