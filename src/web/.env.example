# Public backend URL only. Existing localhost/Render defaults remain in the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only target for same-origin account/chat/history/feedback API rewrites.
API_BACKEND_URL=http://127.0.0.1:8000
# Do not place backend API_KEY or other secrets in NEXT_PUBLIC_* variables.
