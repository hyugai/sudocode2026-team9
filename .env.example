# Tối thiểu để test agent/benchmark với Gemini, PostgreSQL local và Pinecone.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=your_google_api_key_here
# Thinking riêng cho NLU và DeepAgent; LLM persister giữ cấu hình chung.
NLU_THINKING_LEVEL=minimal
DEEPAGENT_THINKING_LEVEL=minimal

# Khớp với container Docker trong docs/deployment/postgresql_self_hosting.md.
DATABASE_URL=postgresql+psycopg2://telesale:telesale_dev_password@localhost:5432/telesale?sslmode=disable

# Auth: browser calls /api through the Next.js rewrite. Set the actual web origin
# on production; HTTPS automatically enables Secure cookies unless overridden.
WEB_ORIGIN=https://agentweb-alpha.vercel.app
SESSION_TTL_DAYS=7
# SESSION_COOKIE_SECURE=true


KNOWLEDGE_BACKEND=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=policy-telesale
PINECONE_NAMESPACE=policy-prod

# Voice input: Zipformer runs locally on CPU; download weights once with
# python scripts/download_asr_model.py
ASR_MODEL_DIR=models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
ASR_NUM_THREADS=2
ASR_MAX_UPLOAD_MB=25
ASR_MAX_DURATION_SECONDS=120
# Optional FFmpeg executable; otherwise use the imageio-ffmpeg bundled binary.
# ASR_FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe

# Native realtime voice (separate from offline Zipformer input).
# Install .[realtime], run scripts/migrate_voice.py, then enable and restart backend.
REALTIME_VOICE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_API_VERSION=v1beta
GEMINI_LIVE_VOICE=Kore
REALTIME_TOOLS_MODE=read_only
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REALTIME_MAX_SESSIONS=4
REALTIME_AUDIO_QUEUE_LIMIT=128
REALTIME_SESSION_IDLE_TIMEOUT_SECONDS=120
REALTIME_SESSION_MAX_SECONDS=600
REALTIME_TOOL_TIMEOUT_SECONDS=25
